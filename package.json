{
  "name": "simpero",
  "version": "6.4.1",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
    "dev:local": "pnpm run db:pg:setup && pnpm run db:health && pnpm dev",
    "build": "node scripts/build.mjs",
    "start": "NODE_ENV=production NODE_OPTIONS=--dns-result-order=ipv4first node dist/index.js",
    "check": "tsc --noEmit && vitest run",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:p0": "vitest run server/analysisJobStore.test.ts",
    "test:p0:db": "ANALYSIS_JOBS_INTEGRATION_TEST=1 vitest run server/analysisJobStore.integration.test.ts",
    "test:deals:db": "DEALS_INTEGRATION_TEST=1 vitest run server/dealsStore.integration.test.ts",
    "verify:p0": "npm run check && npm run test:p0",
    "verify:full": "npm run verify:p0 && npm run test:integration:ci && npm run playwright:install && playwright test",
    "test:integration:ci": "node scripts/run-integration-tests-if-enabled.mjs",
    "test:e2e": "npm run playwright:install && playwright test",
    "test:e2e:ux": "npm run playwright:install && playwright test --grep @ux",
    "test:e2e:ui": "playwright test --ui",
    "playwright:install": "playwright install chromium",
    "screenshots:mvp": "npm run playwright:install && playwright test e2e/mvp-screenshots.spec.ts",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "db:pg:setup": "docker compose up -d && sleep 3 && docker compose exec -T postgres psql -U postgres -d simpero < drizzle/migrations/001_postgres_schema.sql && docker compose exec -T postgres psql -U postgres -d simpero < drizzle/migrations/002_postgres_analysis_jobs.sql && docker compose exec -T postgres psql -U postgres -d simpero < drizzle/migrations/003_postgres_audit_log.sql && docker compose exec -T postgres psql -U postgres -d simpero < drizzle/migrations/004_postgres_users_openid_widen.sql && docker compose exec -T postgres psql -U postgres -d simpero < drizzle/migrations/005_postgres_llm_usage_events.sql && docker compose exec -T postgres psql -U postgres -d simpero < drizzle/migrations/006_postgres_analysis_jobs_usage_rollup.sql && docker compose exec -T postgres psql -U postgres -d simpero < drizzle/migrations/007_postgres_llm_usage_master_summary.sql && docker compose exec -T postgres psql -U postgres -d simpero < drizzle/migrations/008_postgres_user_investment_profile.sql && docker compose exec -T postgres psql -U postgres -d simpero < drizzle/migrations/009_postgres_deals.sql && docker compose exec -T postgres psql -U postgres -d simpero < drizzle/migrations/010_postgres_ic_memo_deliverable.sql && docker compose exec -T postgres psql -U postgres -d simpero < drizzle/migrations/011_postgres_deals_updated_at_trigger.sql && docker compose exec -T postgres psql -U postgres -d simpero < drizzle/migrations/012_postgres_user_investment_profile_jsonb.sql && docker compose exec -T postgres psql -U postgres -d simpero < drizzle/migrations/013_postgres_missing_columns.sql && docker compose exec -T postgres psql -U postgres -d simpero < drizzle/migrations/014_postgres_document_chunks.sql && docker compose exec -T postgres psql -U postgres -d simpero < drizzle/migrations/015_postgres_claims_matched_rename.sql",
    "db:health": "node scripts/db-health.mjs",
    "seed:demo-deals": "tsx scripts/seedDemoDeals.ts",
    "report:llm-usage": "tsx scripts/report-llm-usage.ts",
    "report:llm-usage:json": "tsx scripts/report-llm-usage.ts --json",
    "report:mvp-cost": "tsx scripts/report-mvp-cost.ts",
    "report:mvp-cost:json": "tsx scripts/report-mvp-cost.ts --json",
    "db:backup": "node scripts/db-backup.mjs",
    "lint": "eslint client/src --max-warnings=0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.693.0",
