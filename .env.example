# Clerk publishable key — pk_test_… (staging Clerk instance) or pk_live_… (production)
VITE_CLERK_PUBLISHABLE_KEY=

# Backend API origin. Leave empty for same-origin (/api via DO ingress in prod,
# Vite dev proxy locally). Set to a full origin to target a remote backend.
VITE_API_BASE_URL=

# Umami analytics (optional — analytics load only when endpoint is set)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
